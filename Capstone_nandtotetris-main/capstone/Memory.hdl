
// This file is part of www.nand2tetris.org
// File name: capstone/Memory.hdl

/**
 * Complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O.
 */

CHIP Memory {

    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Route load signal based on address bits
    DMux4Way(
        in=load,
        sel=address[13..14],
        a=loadram1,
        b=loadram2,
        c=loadscreen,
        d=loadkbd
    );

    // Combine RAM load signals
    Or(a=loadram1, b=loadram2, out=loadram);

    // Main RAM: addresses 0-16383
    RAM16K(
        in=in,
        load=loadram,
        address=address[0..13],
        out=outram
    );

    // Screen memory: addresses 16384-24575
    Screen(
        in=in,
        load=loadscreen,
        address=address[0..12],
        out=outscreen
    );

    // Keyboard memory: address 24576
    Keyboard(out=outkbd);

    // Select output based on address
    Mux4Way16(
        a=outram,
        b=outram,
        c=outscreen,
        d=outkbd,
        sel=address[13..14],
        out=out
    );
}
