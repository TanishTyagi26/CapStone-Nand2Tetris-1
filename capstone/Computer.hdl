// File name: capstone/Computer.hdl

/**
 * The HACK computer, including CPU, ROM and RAM.
 * When reset is 0, the program executes.
 * When reset is 1, execution restarts.
 */

CHIP Computer {

    IN reset;

    PARTS:

    // Instruction ROM: 32K words of program memory
    ROM32K(address=pc, out=instruction);

    // Central Processing Unit
    CPU(
        inM=inM,
        instruction=instruction,
        reset=reset,
        outM=outM,
        writeM=writeM,
        addressM=addressM,
        pc=pc
    );

    // Data Memory (RAM + Screen + Keyboard)
    Memory(
        in=outM,
        load=writeM,
        address=addressM,
        out=inM
    );
}
